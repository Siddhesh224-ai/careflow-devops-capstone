# Psycopg 3 SQLAlchemy URL for the Compose database exposed to the host.
# Percent-encode special characters in credentials.
DATABASE_URL=postgresql+psycopg://careflow:replace_with_local_password@localhost:55432/careflow
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
CLINIC_TIMEZONE=Asia/Kolkata
MIN_APPOINTMENT_DURATION=15
MAX_APPOINTMENT_DURATION=240
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRATION_HOURS=48
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_admin_password

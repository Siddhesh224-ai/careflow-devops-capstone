# Local Compose development credentials only. Do not reuse in production.
POSTGRES_USER=careflow
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=careflow
COMPOSE_DATABASE_URL=postgresql+psycopg://careflow:replace_with_local_password@db:5432/careflow
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRATION_HOURS=48
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_admin_password

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_admin_password
